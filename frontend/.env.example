# ============================================================
# InfiniteX Frontend — Variables de Entorno
# Solo variables con prefijo VITE_ son expuestas al navegador
# Copia este archivo a .env y rellena cada valor
# NUNCA commitees el archivo .env
# ============================================================

# --- Supabase (cliente JavaScript) ---
# Obtén estos valores en: Supabase → Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Backend API ---
# Desarrollo: http://localhost:8000
# Producción: URL de tu backend desplegado (Railway, Render, etc.)
VITE_API_BASE_URL=http://localhost:8000
