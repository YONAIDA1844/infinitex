# ============================================================
# InfiniteX Backend — Variables de Entorno
# Copia este archivo a .env y rellena cada valor
# NUNCA commitees el archivo .env
# ============================================================

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Gmail OAuth2 ---
# Genera el refresh token corriendo: python scripts/generate_gmail_token.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=logistica@sicobenediciones.com

# --- Twilio / WhatsApp ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=whatsapp:+1...

# --- Base de Datos ---
# Desarrollo local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./infinitex.db

# Producción (Supabase PostgreSQL):
# Obtén el connection string en: Supabase → Settings → Database → URI
# Reemplaza [YOUR-PASSWORD] con la contraseña del proyecto
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Supabase ---
# Obtén estos valores en: Supabase → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- CORS ---
# URLs del frontend permitidas (separadas por coma)
# En producción agrega tu dominio de Vercel: https://infinitex.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Monday.com ---
# Obtén el API token en: Monday.com → Tu perfil → Developers → API
MONDAY_API_KEY=
MONDAY_BOARD_ID=
MONDAY_BOARD_NAME=Tráfico 2026

# --- Scheduler ---
# Días de anticipación para recordatorios de pago (separados por coma)
APPROVAL_REMINDER_DAYS=3,7,15
